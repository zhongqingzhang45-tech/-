# ============================================
# LifeOS 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================

# ---------- 基础配置 ----------
NODE_ENV=production
PORT=3000
APP_PORT=3000
HOSTNAME=0.0.0.0

# ---------- 应用 URL ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ---------- 数据库配置 (PostgreSQL) ----------
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_secret_2024
POSTGRES_DB=lifeos
DATABASE_URL=postgresql://lifeos:lifeos_secret_2024@localhost:5432/lifeos?schema=public

# ---------- 安全配置 ----------
SESSION_SECRET=your-random-session-secret-at-least-32-chars-please-change
NEXTAUTH_SECRET=your-super-secret-key-change-in-production-please

# ---------- LLM 统一配置（推荐方式，前端完全无感知） ----------
# 提供商: openai | anthropic | deepseek | qwen | glm
LLM_PROVIDER=openai
# 模型名称，根据提供商填写，如 gpt-4o / claude-3-sonnet / deepseek-chat / qwen-max / glm-4
LLM_MODEL=gpt-3.5-turbo
# API Key（优先级最高，若填写则覆盖下方各 provider 独立配置）
LLM_API_KEY=sk-your-api-key-here
# 自定义 Base URL（可选，留空则使用各 provider 默认值）
# LLM_BASE_URL=https://api.openai.com/v1

# ---------- LLM API Keys（Provider 独立配置，兼容旧方式） ----------
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 通义千问（阿里云 DashScope）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 智谱 AI (GLM)
ZHIPU_API_KEY=your-zhipu-api-key-here

# ---------- Redis（可选，用于缓存） ----------
# REDIS_URL=redis://localhost:6379

# ---------- 日志和监控 ----------
LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-here

# ---------- 第三方服务（可选） ----------
# 阿里云短信（用于验证码）
# ALIYUN_ACCESS_KEY_ID=your-access-key
# ALIYUN_ACCESS_KEY_SECRET=your-secret
# ALIYUN_SMS_SIGN_NAME=星野
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxx

# ---------- 支付配置（微信/支付宝） ----------
# 微信支付
# WECHAT_PAY_APP_ID=your-wechat-app-id
# WECHAT_PAY_MCH_ID=your-merchant-id
# WECHAT_PAY_API_KEY=your-api-key-v3
# WECHAT_PAY_CERT_SERIAL_NO=your-cert-serial-no
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/notify/wechat

# 支付宝
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=your-private-key
# ALIPAY_PUBLIC_KEY=your-public-key
# ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/notify/alipay
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付沙箱模式（开发环境）
PAYMENT_SANDBOX=true

# ---------- Docker 部署 ----------
COMPOSE_PROJECT_NAME=lifeos
