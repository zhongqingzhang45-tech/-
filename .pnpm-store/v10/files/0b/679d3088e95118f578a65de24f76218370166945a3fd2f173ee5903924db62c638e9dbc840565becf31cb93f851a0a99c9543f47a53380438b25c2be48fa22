//#region src/artifacts.ts
async function applyArtifactTransformers(artifact, transformers) {
	let currentArtifacts = [artifact];
	for (const transformer of transformers ?? []) {
		const nextArtifacts = [];
		for (const currentArtifact of currentArtifacts) {
			const transformed = await transformer(currentArtifact);
			nextArtifacts.push(...Array.isArray(transformed) ? transformed : [transformed]);
		}
		currentArtifacts = nextArtifacts;
	}
	return currentArtifacts;
}
function createImageArtifact(options) {
	return {
		artifactName: options.artifactName,
		filePath: options.filePath,
		format: "png",
		kind: "image",
		metadata: options.metadata,
		stage: options.stage
	};
}
//#endregion
export { applyArtifactTransformers, createImageArtifact };
