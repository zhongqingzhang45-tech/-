{"version":3,"file":"builtin-BPDNf8Z-.mjs","names":["onStartHooks: (() => void | Promise<void>)[]","onStopHooks: (() => void | Promise<void>)[]"],"sources":["../src/builtin.ts"],"sourcesContent":["export interface LifecycleAppHooks {\n  onStart: (hook: () => void | Promise<void>) => void\n  onStop: (hook: () => void | Promise<void>) => void\n}\n\nexport interface Lifecycle {\n  appHooks: LifecycleAppHooks\n}\n\nexport interface LifecycleTriggerable extends Lifecycle {\n  emitOnStart: () => Promise<void>\n  emitOnStop: () => Promise<void>\n}\n\nexport function buildLifecycle(): Lifecycle {\n  const onStartHooks: (() => void | Promise<void>)[] = []\n  const onStopHooks: (() => void | Promise<void>)[] = []\n\n  const lifecycle: LifecycleTriggerable = {\n    appHooks: {\n      onStart(hook: () => void | Promise<void>) {\n        if (hook) {\n          onStartHooks.push(hook)\n        }\n      },\n      onStop(hook: () => void | Promise<void>) {\n        if (hook) {\n          onStopHooks.push(hook)\n        }\n      },\n    },\n    emitOnStart: async () => {\n      for (const hook of onStartHooks) {\n        await hook()\n      }\n    },\n    emitOnStop: async () => {\n      for (const hook of onStopHooks) {\n        await hook()\n      }\n    },\n  }\n\n  return lifecycle\n}\n"],"mappings":";AAcA,SAAgB,iBAA4B;CAC1C,MAAMA,eAA+C,EAAE;CACvD,MAAMC,cAA8C,EAAE;AA2BtD,QAzBwC;EACtC,UAAU;GACR,QAAQ,MAAkC;AACxC,QAAI,KACF,cAAa,KAAK,KAAK;;GAG3B,OAAO,MAAkC;AACvC,QAAI,KACF,aAAY,KAAK,KAAK;;GAG3B;EACD,aAAa,YAAY;AACvB,QAAK,MAAM,QAAQ,aACjB,OAAM,MAAM;;EAGhB,YAAY,YAAY;AACtB,QAAK,MAAM,QAAQ,YACjB,OAAM,MAAM;;EAGjB"}