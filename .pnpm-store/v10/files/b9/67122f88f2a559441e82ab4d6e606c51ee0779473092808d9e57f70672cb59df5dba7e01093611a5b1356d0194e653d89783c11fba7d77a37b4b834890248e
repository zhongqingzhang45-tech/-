ugins, newPlugins)) return\n      storedPlugins = newPlugins\n      reInit()\n    })\n  }\n\n  return [rootNode, clientApi, serverApi]\n}\n\ndeclare namespace useEmblaCarousel {\n  let globalOptions: EmblaOptionsType | undefined\n}\n\nuseEmblaCarousel.globalOptions = undefined\n\nexport default useEmblaCarousel\n"],"names":["useEmblaCarousel","options","plugins","EmblaCarousel","globalOptions","isRefOptions","isRef","isRefPlugins","storedOptions","value","storedPlugins","serverApi","clientApi","shallowRef","rootNode","reInit","watch","node","destroy","undefined","immediate","onBeforeUnmount","newOptions","areOptionsEqual","newPlugins","arePluginsEqual"],"mappings":";;;;AAcA,SAASA,gBAAgBA,CACvBC,OAAA,GAAsC,EAAE,EACxCC,UAAuC,EAAE,EAAA;AAEzCC,EAAAA,aAAa,CAACC,aAAa,GAAGJ,gBAAgB,CAACI,aAAa;AAE5D,EAAA,MAAMC,YAAY,GAAGC,KAAK,CAACL,OAAO,CAAC;AACnC,EAAA,MAAMM,YAAY,GAAGD,KAAK,CAACJ,OAAO,CAAC;EAEnC,IAAIM,aAAa,GAAGH,YAAY,GAAGJ,OAAO,CAACQ,KAAK,GAAGR,OAAO;EAC1D,IAAIS,aAAa,GAAGH,YAAY,GAAGL,OAAO,CAACO,KAAK,GAAGP,OAAO;EAE1D,MAAMS,SAAS,GAAGR,aAAa,CAAC,IAAI,EAAEK,aAAa,EAAEE,aAAa,CAAC;AACnE,EAAA,MAAME,SAAS,GAAGC,UAAU,EAAqB;AACjD,EAAA,MAAMC,QAAQ,GAAGD,UAAU,EAAe;EAE1C,SAASE,MAAMA,GAAA;AACb,IAAA,IAAI,CAACH,SAAS,CAACH,KAAK,EAAE;IACtBG,SAAS,CAACH,KAAK,CAACM,MAAM,CAACP,aAAa,EAAEE,aAAa,CAAC;AACtD,EAAA;AAEAM,EAAAA,KAAK,CACH,MAAMF,QAAQ,CAACL,KAAK,EACnBQ,IAAI,IAAI;IACP,IAAIL,SAAS,CAACH,KAAK,EAAE;AACnBG,MAAAA,SAAS,CAACH,KAAK,CAACS,OAAO,EAAE;MACzBN,SAAS,CAACH,KAAK,GAAGU,SAAS;AAC7B,IAAA;AAEA,IAAA,IAAIF,IAAI,EAAE;AACRd,MAAAA,aAAa,CAACC,aAAa,GAAGJ,gBAAgB,CAACI,aAAa;MAC5DQ,SAAS,CAACH,KAAK,GAAGN,aAAa,CAACc,IAAI,EAAET,aAAa,EAAEE,aAAa,CAAC;AACrE,IAAA;AACF,EAAA,CAAC,EACD;AAAEU,IAAAA,SAAS,EAAE;AAAI,GAAE,CACpB;AAEDC,EAAAA,eAAe,CAAC,MAAK;IACnB,IAAIT,SAAS,CAACH,KAAK,EAAEG,SAAS,CAACH,KAAK,CAACS,OAAO,EAAE;AAChD,EAAA,CAAC,CAAC;AAEF,EAAA,IAAIb,YAAY,EAAE;AAChBW,IAAAA,KAAK,CAACf,OAAO,EAAGqB,UAAU,IAAI;AAC5B,MAAA,IAAIC,eAAe,CAACf,aAAa,EAAEc,UAAU,CAAC,EAAE;AAChDd,MAAAA,aAAa,GAAGc,UAAU;AAC1BP,MAAAA,MAAM,EAAE;AACV,IAAA,C