    "test:sms": "tsx --test tests/sms.test.ts",
    "test:payment": "tsx --test tests/payment.test.ts",
    "test:llm": "tsx --test tests/llm-config.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
