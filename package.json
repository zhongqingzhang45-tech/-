    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "prisma": "^7.8.0",
    "tailwindcss": "3.4.4",
    "tsx": "^4.23.1",
    "typescript": "5.4.5"
